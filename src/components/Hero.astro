---
import { Image } from "astro:assets";
import heroImg from "../assets/hero.png";
import heroMobileImg from "../assets/hero-mobile.png";
import { promoPrimoMese, numeroIt } from "../data/piani";
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <video
      class="hero__bg-img hero__bg-img--wide"
      src="/hero.mp4"
      poster={heroImg.src}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    ></video>
    <Image
      class="hero__bg-img hero__bg-img--mobile"
      src={heroMobileImg}
      alt=""
      widths={[480, 720, 960]}
      sizes="100vw"
      loading="eager"
    />
    <span class="hero__scrim"></span>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="eyebrow" data-hero="1">
        <span class="dot-live"></span> Assistente AI per telefono e appuntamenti · 24/7
      </span>

      <h1 data-hero="2" data-hero-title>
        Gestisce le chiamate e riempie<br />
        <span class="hero__hl">la tua agenda mentre lavori.</span>
      </h1>

      <p class="lead" data-hero="3">
        SofIA risponde al <strong>telefono, in chat e su WhatsApp</strong>.
        Capisce cosa chiede il cliente, verifica le disponibilità, fissa
        l'appuntamento e registra la conversazione. Parla nella lingua di chi
        la contatta.
      </p>

      <div class="hero__actions" data-hero="4">
        <a href="#prova" class="btn btn--primary btn--lg" data-trial-open>
          <span class="dot-live"></span> Prova SofIA gratis
        </a>
        <a href="#oltre" class="btn btn--outline btn--lg">Guarda come lavora</a>
      </div>

      <a class="hero__promo" href="/pricing" data-hero="5">
        <span class="hero__promo-tag">Offerta di lancio</span>
        <span class="hero__promo-figure">
          {numeroIt(promoPrimoMese.prezzo)}<span class="hero__promo-cur">€</span>
        </span>
        <span class="hero__promo-text">
          <strong>il primo mese</strong>, IVA inclusa · {numeroIt(promoPrimoMese.minuti)} minuti
          <span class="sr-only">, vedi i piani</span>
        </span>
        <svg class="hero__promo-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <ul class="hero__trust" data-hero="6">
        <li>Voce naturale multilingua</li>
        <li>Si collega ai tuoi strumenti</li>
        <li>Prova gratuita di 3 minuti</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 78vh, 820px);
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--section-y);
    overflow: hidden;
  }
  /* L'immagine occupa solo la PORZIONE DESTRA della hero (da ~38% in poi);
     il lato sinistro resta sfondo crema della pagina per il testo. Il box è
     sempre dentro al viewport: nessun rischio di overflow orizzontale. */
  .hero__bg {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 22%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* Su desktop si vede solo la panoramica; quella quadrata è per mobile. */
  .hero__bg-img--mobile {
    display: none;
  }
  /* Velo crema sul bordo sinistro dell'immagine: la fonde nello sfondo e
     garantisce il contrasto del testo scuro. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--cream) 0%,
      rgba(249, 245, 227, 0.55) 22%,
      rgba(249, 245, 227, 0) 48%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero__copy {
    display: grid;
    gap: 1.2rem;
    max-width: 44rem;
    width: min(100%, 52%);
  }
  .hero h1 {
    margin-top: 0.4rem;
    font-size: clamp(1.9rem, 1.2rem + 2.2vw, 2.75rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
  }
  .hero__hl {
    color: var(--coral);
    position: relative;
  }
  /* SplitText line masks clip with overflow; the extra bottom padding (offset
     by negative margin so layout height is unchanged) keeps descenders from
     being clipped while words rise into view. will-change hints the compositor
     for the one-shot intro tween. */
  .hero h1 .hero-line-mask {
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }
  .hero h1 .hero-line {
    will-change: transform;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.4rem;
  }
  /* ---- cartellino offerta primo mese ----
     Sta fra le CTA e la lista trust: il numero è grande abbastanza da
     fermare l'occhio, ma resta sotto alle azioni, non le scavalca. Il fondo
     è pieno perché qui sotto scorre il video della hero. */
  .hero__promo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    /* Appesa alle CTA: il margine negativo le tiene legate, così si leggono
       come un blocco solo e la lista trust resta sopra la piega. */
    margin-top: -0.4rem;
    max-width: 100%;
    padding: 0.55rem 0.95rem;
    background: var(--surface);
    border: 1.5px solid var(--coral-100);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
  }
  /* Il prefisso .hero serve a battere in specificità il `transform: none`
     che il reveal applica con .is-in: senza, l'hover non si muoverebbe. */
  .hero .hero__promo {
    transition:
      opacity var(--dur-reveal) var(--ease-out),
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.25s var(--ease-out);
  }
  .hero .hero__promo:hover,
  .hero .hero__promo:focus-visible {
    border-color: var(--coral);
    box-shadow: var(--shadow-coral);
    transform: translateY(-2px);
  }
  .hero__promo-tag {
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: var(--coral);
    color: #fff;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero__promo-figure {
    display: flex;
    align-items: baseline;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.85rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--coral-700);
  }
  .hero__promo-cur {
    margin-left: 0.1em;
    font-size: 0.62em;
    color: var(--coral);
  }
  .hero__promo-text {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--ink-soft);
  }
  .hero__promo-text strong {
    color: var(--ink);
  }
  /* Freccia al posto di un "vedi i piani" scritto: la strip è già tutta un
     link, e così il testo sta su una riga sola. */
  .hero__promo-arrow {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    margin-left: auto;
    color: var(--coral-700);
    transition: transform 0.2s ease;
  }
  .hero .hero__promo:hover .hero__promo-arrow {
    transform: translateX(3px);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }
  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__trust li::before {
    content: "✓";
    color: var(--green);
    font-weight: 800;
  }

  /* demo card */
  .hero__demo {
    position: relative;
    display: grid;
    gap: 1rem;
    justify-items: center;
  }
  .hero__illustration {
    margin: 0;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    background: var(--cream-soft);
  }
  .hero__illustration img {
    display: block;
    width: 100%;
    height: auto;
  }
  .demo-card {
    width: min(100%, 420px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .demo-card__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }
  .demo-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: linear-gradient(150deg, var(--coral), var(--coral-600));
    color: #fff;
    font-family: var(--font-head);
    font-weight: 800;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-coral);
  }
  .demo-card__name {
    font-weight: 700;
    font-family: var(--font-head);
    line-height: 1.1;
  }
  .demo-card__status {
    font-size: 0.78rem;
    color: var(--green);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }
  .demo-card__time {
    margin-left: auto;
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .demo-feed {
    padding: 1.2rem;
    display: grid;
    gap: 0.7rem;
  }
  .ev {
    --b: var(--surface-2);
    max-width: 86%;
    padding: 0.7rem 0.95rem;
    border-radius: 16px;
    font-size: 0.92rem;
    line-height: 1.4;
    background: var(--b);
    border: 1px solid var(--line);
  }
  .ev p {
    margin: 0;
  }
  .ev--in {
    justify-self: start;
    border-bottom-left-radius: 5px;
  }
  .ev--out {
    justify-self: end;
    background: var(--green);
    color: #fff;
    border-color: transparent;
    border-bottom-right-radius: 5px;
  }
  .ev__tag {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin-bottom: 0.4rem;
  }
  .ev__tag--tel {
    background: var(--coral-100);
    color: var(--coral-700);
  }
  .ev__tag--wa {
    background: var(--green-100);
    color: var(--green-700);
  }
  .ev--booked {
    max-width: 100%;
    justify-self: stretch;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: linear-gradient(120deg, var(--coral-050), var(--surface));
    border: 1.5px solid var(--coral-100);
    padding: 0.9rem 1rem;
  }
  .ev__check {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--coral);
    color: #fff;
    font-weight: 800;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-coral);
  }
  .ev__booked-title {
    font-weight: 700;
    font-family: var(--font-head);
  }
  .ev__booked-sub {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .demo-channels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .demo-channels__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .demo-channels__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--coral);
  }
  .demo-channels__item--chat .demo-channels__dot {
    background: var(--green);
  }
  .demo-channels__item--wa .demo-channels__dot {
    background: var(--wa-green);
  }
  .demo-channels__item--agenda .demo-channels__dot {
    background: var(--taupe);
  }

  @media (max-width: 920px) {
    /* Niente sovrapposizione su mobile: testo sopra, illustrazione sotto. */
    .hero {
      flex-direction: column;
      min-height: 0;
      align-items: stretch;
      padding-bottom: 0;
    }
    .hero__inner {
      order: 1;
    }
    .hero__copy {
      max-width: 100%;
      width: 100%;
    }
    .hero__bg {
      position: relative;
      order: 2;
      inset: auto;
      margin-top: clamp(1.5rem, 1rem + 3vw, 2.5rem);
    }
    .hero__bg-img {
      height: auto;
      object-fit: contain;
    }
    /* Switch immagini: su mobile mostra la quadrata, nascondi la panoramica. */
    .hero__bg-img--wide {
      display: none;
    }
    .hero__bg-img--mobile {
      display: block;
    }
    .hero__scrim {
      display: none;
    }
  }
</style>
