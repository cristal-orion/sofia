---
import "../styles/global.css";
import { faqs, type Faq } from "../data/faq";
import { piani, promoPrimoMese, numeroIt } from "../data/piani";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title?: string;
  description?: string;
  /** FAQ da pubblicare come FAQPage su questa rotta. [] = nessun FAQPage. */
  faqEntries?: Faq[];
}

const {
  title = "SofIA — Il gestionale di appuntamenti che lavora al telefono per te",
  description = "SofIA risponde al telefono, chatta sul sito, scrive su WhatsApp e gestisce la tua agenda. L'assistente AI proattivo che fissa appuntamenti e non perde mai un cliente, 24/7.",
  faqEntries = faqs,
} = Astro.props;

// URL assolute per canonical / Open Graph (richiede `site` in astro.config).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-sofia.jpg", Astro.site).href;

// Dati strutturati (JSON-LD): aiutano motori di ricerca e LLM a capire COS'È
// SofIA, chi la produce e cosa fa. Un solo @graph con le entità collegate.
const orgId = `${Astro.site}#affinitylab`;
const productId = `${Astro.site}#sofia`;
// Con slash finale: è la forma che nginx serve e che finisce nella sitemap.
const pricingUrl = new URL("/pricing/", Astro.site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: "Affinity Lab",
      legalName: "Affinity Srl",
      url: "https://www.affinitylab.it",
      vatID: "IT06221050658",
      email: "info@affinitylab.it",
      telephone: "+39 328 865 8690",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Via Lanzara, 33",
        addressLocality: "Nocera Inferiore",
        addressRegion: "SA",
        addressCountry: "IT",
      },
    },
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site?.href,
      name: "SofIA",
      inLanguage: "it-IT",
      publisher: { "@id": orgId },
    },
    {
      "@type": "SoftwareApplication",
      "@id": productId,
      name: "SofIA",
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Assistente AI per la gestione di appuntamenti e chiamate",
      operatingSystem: "Web, iOS, Android",
      url: Astro.site?.href,
      inLanguage: "it-IT",
      sameAs: [
        "https://www.instagram.com/pronto_sofia/",
        "https://www.facebook.com/profile.php?id=61590677727103",
      ],
      description:
        "SofIA è l'assistente AI che gestisce telefono, chat sul sito, WhatsApp e agenda di un'attività. Risponde alle chiamate con voce naturale multilingua, qualifica i clienti, fissa e sincronizza gli appuntamenti sul calendario, richiama i clienti in autonomia e produce report giornalieri — 24 ore su 24.",
      featureList: [
        "Risponde al telefono con voce naturale multilingua, anche a più chiamate insieme",
        "Chatta sul sito web e su WhatsApp",
        "Fissa appuntamenti e li sincronizza sul calendario (Google Calendar, iCal)",
        "Chiamate in uscita: promemoria, conferme e follow-up automatici",
        "Riassunto di ogni chiamata e report giornaliero dell'attività",
        "Knowledge base che impara a ogni conversazione",
        "Configurabile per settore da dashboard: servizi, orari, prezzi, tono di voce",
      ],
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "EUR",
        lowPrice: String(promoPrimoMese.prezzo),
        highPrice: String(Math.max(...piani.map((p) => p.mensile))),
        offerCount: piani.length + 2,
        url: pricingUrl,
        offers: [
          {
            "@type": "Offer",
            name: "Prova gratuita",
            category: "Prova gratuita",
            price: "0",
            priceCurrency: "EUR",
            description: "Prova gratuita di 3 minuti, parlando direttamente con SofIA dal sito.",
          },
          {
            "@type": "Offer",
            "@id": `${pricingUrl}#primo-mese`,
            name: "Primo mese in promozione",
            url: pricingUrl,
            price: String(promoPrimoMese.prezzo),
            priceCurrency: "EUR",
            availability: "https://schema.org/InStock",
            category: "PROMO fino al 15 ottobre",
            description: `PROMO valida fino al 15 ottobre: primo mese di servizio a ${promoPrimoMese.prezzo} € IVA inclusa, con ${numeroIt(promoPrimoMese.minuti)} minuti di conversazione. Dal secondo mese vale il piano scelto.`,
            priceSpecification: {
              "@type": "UnitPriceSpecification",
              price: String(promoPrimoMese.prezzo),
              priceCurrency: "EUR",
              valueAddedTaxIncluded: true,
              referenceQuantity: {
                "@type": "QuantitativeValue",
                value: 1,
                unitCode: "MON",
              },
            },
          },
          ...piani.map((p) => ({
            "@type": "Offer",
            "@id": `${pricingUrl}#${p.id}`,
            name: `SofIA ${p.nome}`,
            url: pricingUrl,
            price: String(p.mensile),
            priceCurrency: "EUR",
            availability: "https://schema.org/InStock",
            category: "Abbonamento mensile",
            description: `${numeroIt(p.minuti)} minuti di conversazione al mese, ${p.numeri.toLowerCase()}, risposta attiva 24/7 e CRM appuntamenti. ${numeroIt(p.trimestrale)} € al mese con fatturazione trimestrale. Prezzi IVA esclusa.`,
            priceSpecification: {
              "@type": "UnitPriceSpecification",
              price: String(p.mensile),
              priceCurrency: "EUR",
              valueAddedTaxIncluded: false,
              referenceQuantity: {
                "@type": "QuantitativeValue",
                value: 1,
                unitCode: "MON",
              },
            },
          })),
        ],
      },
      provider: { "@id": orgId },
      publisher: { "@id": orgId },
    },
    ...(faqEntries.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${canonical}#faq`,
            mainEntity: faqEntries.map((f) => ({
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="it" class="no-js">
  <head>
    <!-- Consent bootstrap — GDPR / Linee guida cookie del Garante.
         Nessun tracker non necessario (GTM, Klaviyo) parte prima del consenso.
         Google Consent Mode v2 è impostato su "denied" di default; il banner
         (CookieConsent.astro) chiama window.SofiaConsent.set(...) per aggiornare
         il consenso e caricare gli script SOLO per le categorie accettate. -->
    <script is:inline>
      (function () {
        var STORE_KEY = "sofia-cookie-consent";
        var VERSION = 1; // incrementa per ri-chiedere il consenso se cambiano i tracker
        var GTM_ID = "GTM-PS98FD2J";
        var KLAVIYO_ID = "TATHwU";

        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;

        // Consent Mode v2: tutto negato finché l'utente non sceglie.
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
          functionality_storage: "granted",
          security_storage: "granted",
          wait_for_update: 500,
        });

        var gtmDone = false, klaviyoDone = false;

        function loadGTM() {
          if (gtmDone) return; gtmDone = true;
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0], j = d.createElement(s),
                dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", GTM_ID);
        }

        function loadKlaviyo() {
          if (klaviyoDone) return; klaviyoDone = true;
          var s = document.createElement("script");
          s.async = true;
          s.type = "text/javascript";
          s.src = "https://static.klaviyo.com/onsite/js/" + KLAVIYO_ID + "/klaviyo.js?company_id=" + KLAVIYO_ID;
          document.head.appendChild(s);
          // Shim window.klaviyo così le push funzionano appena il file è pronto.
          !function(){if(!window.klaviyo){window._klOnsite=window._klOnsite||[];try{window.klaviyo=new Proxy({},{get:function(n,i){return"push"===i?function(){var n;(n=window._klOnsite).push.apply(n,arguments)}:function(){for(var n=arguments.length,o=new Array(n),w=0;w<n;w++)o[w]=arguments[w];var t="function"==typeof o[o.length-1]?o.pop():void 0,e=new Promise((function(n){window._klOnsite.push([i].concat(o,[function(i){t&&t(i),n(i)}]))}));return e}}})}catch(n){window.klaviyo=window.klaviyo||[],window.klaviyo.push=function(){var n;(n=window._klOnsite).push.apply(n,arguments)}}}}();
        }

        function apply(consent) {
          gtag("consent", "update", {
            analytics_storage: consent.analytics ? "granted" : "denied",
            ad_storage: consent.marketing ? "granted" : "denied",
            ad_user_data: consent.marketing ? "granted" : "denied",
            ad_personalization: consent.marketing ? "granted" : "denied",
          });
          if (consent.analytics || consent.marketing) loadGTM();
          if (consent.marketing) loadKlaviyo();
        }

        function read() {
          try {
            var raw = localStorage.getItem(STORE_KEY);
            if (!raw) return null;
            var data = JSON.parse(raw);
            return data && data.v === VERSION ? data : null;
          } catch (e) { return null; }
        }

        function save(consent) {
          var record = {
            analytics: !!consent.analytics,
            marketing: !!consent.marketing,
            v: VERSION,
            ts: new Date().toISOString(),
          };
          try { localStorage.setItem(STORE_KEY, JSON.stringify(record)); } catch (e) {}
          apply(record);
          document.dispatchEvent(new CustomEvent("sofia:consent-updated", { detail: record }));
        }

        window.SofiaConsent = {
          version: VERSION,
          get: read,
          set: save,
          hasChoice: function () { return !!read(); },
        };

        // Consenso già espresso in una visita precedente → riapplica subito.
        var existing = read();
        if (existing) apply(existing);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/sofia-logo-mark.webp" />
    <link rel="apple-touch-icon" href="/sofia-logo-mark.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ff5f49" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SofIA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SofIA — Risponde, scrive e fissa appuntamenti. Mentre tu lavori." />
    <meta property="og:locale" content="it_IT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="SofIA — Risponde, scrive e fissa appuntamenti. Mentre tu lavori." />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Hide reveal elements from first paint (no flash). If the bundled GSAP
      // script never runs (load error), the fallback timer reveals everything
      // so content is never permanently invisible.
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("reveal-on");
      window.__revealFallback = setTimeout(function () {
        document
          .querySelectorAll("[data-reveal], [data-hero], [data-ev]")
          .forEach(function (el) {
            el.classList.add("is-in");
          });
      }, 2000);
    </script>
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>
